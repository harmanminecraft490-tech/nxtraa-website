generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  orders        Order[]
  sessions      Session[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Order {
  id                 String       @id @default(cuid())
  orderNumber        String       @unique
  userId             String
  subtotal           Int
  deliveryFee        Int
  discount           Int          @default(0)
  total              Int
  currency           String       @default("INR")
  payment                      String
  paymentStatus                PaymentStatus @default(PENDING)
  cashfreeOrderId              String?      @unique
  cashfreePaymentId            String?
  cashfreePaymentStatus        String?
  cashfreeTransactionId        String?
  status                       OrderStatus  @default(confirmed)
  recipientName                String
  phone                        String
  addressLine                  String
  city                         String
  pincode                      String
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  // Shiprocket integration fields
  shipmentId                   String?
  shipmentStatus               String?
  trackingNumber               String?
  awbCode                      String?
  trackingUrl                  String?
  courierName                  String?
  courierCompany               String?
  shippingCharges              Int?
  pickupToken                  String?
  pickupScheduled              Boolean      @default(false)
  labelUrl                     String?
  invoiceUrl                   String?
  estimatedDelivery            DateTime?
  shipmentCreatedAt            DateTime?
  lastTrackingUpdate           DateTime?
  shipmentResponse             Json?
  shipmentRetryCount           Int          @default(0)

  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                        OrderItem[]
  shipmentLogs                 ShipmentLog[]
  @@index([cashfreeOrderId])
  @@index([cashfreePaymentId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId Int
  quantity  Int
  unitPrice Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Product {
  id Int @id @default(autoincrement())

  title       String
  model       String
  price       Int
  oldPrice    Int
  rating      Int
  badge       String
  category    String
  color       String
  description String
  stock       Int        @default(100)

  // Dimensions for shipping
  weight      Float?     // in kg
  length      Float?     // in cm
  width       Float?     // in cm
  height      Float?     // in cm
  hsnCode     String?

  highlights String[]
  imageUrls  String[]
}
model ShipmentLog {
  id          String   @id @default(cuid())
  orderId     String
  action      String
  status      String?
  details     Json?
  error       String?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Banner {
  id              Int      @id @default(autoincrement())
  src             String
  href            String
  alt             String
  order           Int      @default(0)
  desktopImageUrl String?
  mobileImageUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
